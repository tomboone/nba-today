# nba-today runtime configuration (spec §8). Copy to `.env` beside docker-compose.yml.
# Commented-out values are the defaults; blank ones are unset.

# Required: comma-separated recipient addresses.
RECIPIENTS=

# Schedule. Times are local to TZ_LOCAL.
# TZ_LOCAL=America/New_York
# PLAN_TIME=03:00
# SEND_LEAD_MINUTES=30
# SCORES_ONLY_TIME=09:00

# Volume for snapshots, state, and dry-run output. Matches the compose mount.
# DATA_DIR=/data

# Resend transport: set both to enable.
RESEND_API_KEY=
RESEND_FROM=

# SMTP transport: set credentials and sender to enable.
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=

# Order of the transport chain.
# TRANSPORTS=resend,smtp

# healthchecks.io ping URL (https://hc-ping.com/<uuid>); unset disables the heartbeat. Pinged
# after each send, and at `/fail` when a send's retry fails too. Suggested check settings:
# period 1 day, grace 12 hours (a noon holiday tip followed by a 7:30 PM tip is 31.5 hours
# between sends). Only send days ping, so pause the check over the All-Star break and the
# off-season.
HEALTHCHECKS_URL=

# DRY_RUN=false
# LOG_LEVEL=INFO

# Kill switch for every NBA.com fetch; false builds the digest from ESPN alone.
# NBA_ENRICHMENT=true

# Source base URLs, overridable for tests.
# ESPN_SITE_API_BASE=https://site.api.espn.com
# ESPN_WEB_API_BASE=https://site.web.api.espn.com
# NBA_CDN_BASE=https://cdn.nba.com
# NBA_STATS_BASE=https://stats.nba.com
